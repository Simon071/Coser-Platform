{
  "name": "Coser-Platform",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rspeedy build",
    "build:web": "rspeedy build --environment web",
    "build:lynx": "rspeedy build --environment lynx",
    "dev": "rspeedy dev",
    "dev:web": "rspeedy dev --environment web",
    "preview": "rspeedy preview",
    "preview:web": "rspeedy preview --environment web",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,sass,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,sass,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@lynx-js/react": "^0.114.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lynx-js/preact-devtools": "^5.0.1-cf9aef5",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.4.3",
    "@lynx-js/react-rsbuild-plugin": "^0.11.4",
    "@lynx-js/rspeedy": "^0.12.0",
    "@lynx-js/types": "3.4.11",
    "@rsbuild/plugin-sass": "^1.4.0",
    "@rsbuild/plugin-type-check": "1.2.4",
    "@testing-library/jest-dom": "^6.9.0",
    "@types/react": "^18.3.25",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "sass": "^1.94.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=22.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,scss,sass,md}": [
      "prettier --write"
    ]
  }
}
