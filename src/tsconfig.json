{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,

    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "~context": ["./context"],
      "~context/*": ["./context/*"],
      "~utils": ["./utils"],
      "~utils/*": ["./utils/*"],
      "~types": ["./types"],
      "~types/*": ["./types/*"],
      "~pages": ["./pages"],
      "~pages/*": ["./pages/*"],
      "~components": ["./components"],
      "~components/*": ["./components/*"],
      "~assets": ["./assets"],
      "~assets/*": ["./assets/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
